{
  "name": "shoji",
  "version": "0.1.0-alpha.4",
  "description": "Zero-dependency TypeScript lightbox/gallery library.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelYagi/shoji.git"
  },
  "homepage": "https://github.com/MichaelYagi/shoji#readme",
  "bugs": {
    "url": "https://github.com/MichaelYagi/shoji/issues"
  },
  "main": "./dist/shoji.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "unpkg": "./dist/shoji.min.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/shoji.js",
      "default": "./dist/shoji.js"
    },
    "./style.css": "./dist/shoji.css",
    "./core": {
      "types": "./dist/esm/core/index.d.ts",
      "import": "./dist/esm/core/index.js"
    },
    "./plugins/*": {
      "types": "./dist/esm/plugins/*/index.d.ts",
      "import": "./dist/esm/plugins/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "size": "npm run build && size-limit",
    "docs": "typedoc",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:e2e && npm run size"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.50.0",
    "@size-limit/file": "^11.1.6",
    "@types/node": "^22.10.7",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "size-limit": "^11.1.6",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.4"
  }
}
